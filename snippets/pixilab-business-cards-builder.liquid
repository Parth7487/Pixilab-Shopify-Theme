    },
    '24_pt_trifecta_green': {
      sizes: ['2" x 3.5" U.S. Standard', '1.75" x 3"', '1.75" x 3.5"', '2" x 3"', '2.17" x 3.35" European Standard'],
      colors: ['Full Color Both Sides', 'Full Color Front, No Back'],
      coatings: ['Velvet Finish'],
      quantities: [250, 500, 1000, 2500, 5000]
    },
    '38_pt_trifecta_black': {
      sizes: ['2" x 3.5" U.S. Standard', '1.75" x 3"', '1.75" x 3.5"', '2" x 3"', '2.17" x 3.35" European Standard'],
      colors: ['Full Color Both Sides', 'Full Color Front, No Back'],
      coatings: ['Velvet Finish'],
      quantities: [250, 500, 1000, 2500, 5000]
    },
    '38_pt_trifecta_red': {
      sizes: ['2" x 3.5" U.S. Standard', '1.75" x 3"', '1.75" x 3.5"', '2" x 3"', '2.17" x 3.35" European Standard'],
      colors: ['Full Color Both Sides', 'Full Color Front, No Back'],
      coatings: ['Velvet Finish'],
      quantities: [250, 500, 1000, 2500, 5000]
    },
    '38_pt_trifecta_blue': {
      sizes: ['2" x 3.5" U.S. Standard', '1.75" x 3"', '1.75" x 3.5"', '2" x 3"', '2.17" x 3.35" European Standard'],
      colors: ['Full Color Both Sides', 'Full Color Front, No Back'],
      coatings: ['Velvet Finish'],
      quantities: [250, 500, 1000, 2500, 5000]
    }
  };

  const currentStock = '{{ current_stock_key }}';
  const cfg = STOCK_CONFIGS[currentStock] || STOCK_CONFIGS['14_pt_gloss'];

  const state = {
    orientation: 'Horizontal',
    size: cfg.sizes[0],
    paperStock: '{{ current_stock_label }}',
    color: cfg.colors[0],
    coating: cfg.coatings[0],
    quantity: cfg.quantities[0].toString(),
    isRound: '0',
    productionTime: '2-4 Business Days (Standard)',
    processType: 'Instantly Process',
    pdfProof: false,
    designService: false,
    frontFile: null,
    backFile: null
  };

  // Populate dynamic select dropdowns according to stock
  function initSelect(id, items, currentVal) {
    const el = document.getElementById(id);
    if (!el) return;
    el.innerHTML = '';
    items.forEach(it => {
      const opt = document.createElement('option');
      opt.value = it;
      opt.textContent = it;
      if (it === currentVal) opt.selected = true;
      el.appendChild(opt);
    });
  }

  function initQuantities(items, currentVal) {
    const grid = document.getElementById('pxQtyGrid');
    if (!grid) return;
    grid.innerHTML = '';
    items.forEach(q => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'px-qty-btn' + (q.toString() === currentVal.toString() ? ' active' : '');
      btn.setAttribute('data-qty', q.toString());
      btn.textContent = Number(q).toLocaleString();
      btn.addEventListener('click', function() {
        grid.querySelectorAll('.px-qty-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        state.quantity = this.getAttribute('data-qty');
        calculatePrice();
      });
      grid.appendChild(btn);
    });
  }

  initSelect('pxSelectSize', cfg.sizes, state.size);
  initSelect('pxSelectColor', cfg.colors, state.color);
  initSelect('pxSelectCoating', cfg.coatings, state.coating);
  initQuantities(cfg.quantities, state.quantity);

  // Load pricing matrix
  fetch("{{ current_pricing | asset_url }}")
    .then(r => r.json())
    .then(data => {
      pricingData = data;
      calculatePrice();
    })
    .catch(err => {
      console.warn("Pricing file load fallback:", err);
    });

  // 1. Size
  const selectSize = document.getElementById('pxSelectSize');
  if (selectSize) {
    selectSize.addEventListener('change', function() {
      state.size = this.value;
      calculatePrice();
    });
  }

  // 2. Orientation
  const orientPills = document.querySelectorAll('#pxGroupOrientation .px-pill');
  orientPills.forEach(p => {
    p.addEventListener('click', function() {
      orientPills.forEach(x => x.classList.remove('active'));
      this.classList.add('active');
      state.orientation = this.getAttribute('data-val');
      calculatePrice();
    });
  });

  // 4. Color
  const selectColor = document.getElementById('pxSelectColor');
  if (selectColor) {
    selectColor.addEventListener('change', function() {
      state.color = this.value;
      calculatePrice();
    });
  }

  // 6. Rounded corners
  const roundCornerBtn = document.querySelector('#pxGroupCorners .px-pill[data-round="1"]');
  if (roundCornerBtn) {
    if (['38_pt_trifecta_black', '38_pt_trifecta_red', '38_pt_trifecta_blue'].includes(currentStock)) {
      roundCornerBtn.style.display = 'none';
      state.isRound = '0';
    } else {
      roundCornerBtn.style.display = '';
    }
  }

  const cornerPills = document.querySelectorAll('#pxGroupCorners .px-pill');
  cornerPills.forEach(p => {
    p.addEventListener('click', function() {
      cornerPills.forEach(x => x.classList.remove('active'));
      this.classList.add('active');
      state.isRound = this.getAttribute('data-round');
      calculatePrice();
    });
  });

  // 7. Coating
  const selectCoating = document.getElementById('pxSelectCoating');
  if (selectCoating) {
    selectCoating.addEventListener('change', function() {
      state.coating = this.value;
      calculatePrice();
    });
  }

  // 8. Production Time
  const selectProdTime = document.getElementById('pxSelectProductionTime');
  if (selectProdTime) {
    selectProdTime.addEventListener('change', function() {
      state.productionTime = this.value;
      const badge = document.getElementById('pxTurnaroundBadge');
      if (badge) {
        badge.innerText = this.value.includes('Next Day') ? '1 Day Rush' : '2-4 Days Turnaround';
      }
      calculatePrice();
    });
  }

  // 9. Process Type & Checkboxes
  const pdfProofCheckbox = document.getElementById('pxPdfProofCheckbox');
  const pdfProofCard = document.getElementById('pxPdfProofCard');
  if (pdfProofCheckbox) {
    pdfProofCheckbox.addEventListener('change', function() {
      state.pdfProof = this.checked;
      if (pdfProofCard) {
        if (this.checked) pdfProofCard.classList.add('active');
        else pdfProofCard.classList.remove('active');
      }
      calculatePrice();
    });
  }

  const designCheckbox = document.getElementById('pxDesignServiceCheckbox');
  const designCard = document.getElementById('pxDesignServiceCard');
  if (designCheckbox) {
    designCheckbox.addEventListener('change', function() {
      state.designService = this.checked;
      if (designCard) {
        if (this.checked) designCard.classList.add('active');
        else designCard.classList.remove('active');
      }
      calculatePrice();
    });
  }

  // Artwork Uploads
  const frontInput = document.getElementById('pxUploadFront');
  const frontStatus = document.getElementById('pxUploadFrontStatus');
  if (frontInput) {
    frontInput.addEventListener('change', function() {
      if (this.files && this.files[0]) {
        state.frontFile = this.files[0].name;
        if (frontStatus) frontStatus.innerText = '✓ ' + this.files[0].name;
      } else {
        state.frontFile = null;
        if (frontStatus) frontStatus.innerText = 'No file chosen';
      }
      calculatePrice();
    });
  }

  const backInput = document.getElementById('pxUploadBack');
  const backStatus = document.getElementById('pxUploadBackStatus');
  if (backInput) {
    backInput.addEventListener('change', function() {
      if (this.files && this.files[0]) {
        state.backFile = this.files[0].name;
        if (backStatus) backStatus.innerText = '✓ ' + this.files[0].name;
      } else {
        state.backFile = null;
        if (backStatus) backStatus.innerText = 'No file chosen';
      }
      calculatePrice();
    });
  }

  function calculatePrice() {
    if (!pricingData) return;

    // Direct key lookup
    const key = `${state.orientation}|${state.size}|${state.color}|${state.coating}|${state.quantity}|${state.isRound}`;
    let wholesale = pricingData[key];

    // Fallback lookup if exact match not found
    if (wholesale === undefined) {
      const candidateKeys = Object.keys(pricingData).filter(k => k.includes(`|${state.quantity}|`));
      if (candidateKeys.length > 0) {
        wholesale = pricingData[candidateKeys[0]];
      } else {
        const anyKeys = Object.keys(pricingData);
        if (anyKeys.length > 0) wholesale = pricingData[anyKeys[0]];
      }
    }

    if (wholesale === undefined || isNaN(wholesale)) {
      wholesale = 11.50;
    }

    let retail = wholesale * MARKUP;
    
    // Add-on checkboxes
    if (state.pdfProof) {
      retail += 2.00;
    }
    if (state.designService) {
      retail += 50.00;
    }

    const qtyNum = parseInt(state.quantity) || 250;
    const perUnit = retail / qtyNum;

    const retailStr = '$' + retail.toFixed(2);
    const retailDisplay = document.getElementById('pxRetailPriceDisplay');
    const unitDisplay = document.getElementById('pxUnitPriceDisplay');
    if (retailDisplay) retailDisplay.innerText = retailStr;
    if (unitDisplay) unitDisplay.innerText = '$' + perUnit.toFixed(3) + ' per card · Free Digital Proof';

    // Update all native Shopify price elements on page
    document.querySelectorAll('.product-price, .price, #show_price_block, [data-price], .money, .price-review .price').forEach(el => {
      const span = el.querySelector('.money, .current-price, .price-item') || el;
      if (span && !span.id?.includes('pxRetailPriceDisplay')) {
        span.innerText = retailStr;
      }
    });

    // Attach custom properties to Shopify cart form
    syncProperties(retailStr, wholesale);
  }

  function syncProperties(retailStr, wholesale) {
    const form = document.querySelector('form[action*="/cart/add"]');
    if (!form) return;

    const props = {
      'Size': state.size,
      'Orientation': state.orientation,
      'Paper Stock': state.paperStock,
      'Color': state.color,
      'Quantity': state.quantity + ' Cards',
      'Rounded Corners': state.isRound === '1' ? 'Round Corners (1/4" Radius)' : 'Standard Square',
      'Coating': state.coating,
      'Production Time': state.productionTime,
      'Process Type': state.processType,
      'PDF Proof ($2.00)': state.pdfProof ? 'Yes (+$2.00 digital PDF proof requested)' : 'No',
      'Let Us Design It For You ($50.00)': state.designService ? 'Yes (+$50.00 custom layout design)' : 'No (Print-Ready Artwork Provided)',
      'Shipping Estimate': 'Calculated at checkout',
      'Front Artwork File': state.frontFile || 'Pending Customer Upload / Email',
      'Back Artwork File': state.backFile || (state.color.includes('Both Sides') ? 'Pending Customer Upload / Email' : 'Not Required (Single Sided)'),
      'Subtotal Amount': retailStr,
      '_wholesaleCost': '$' + Number(wholesale).toFixed(2),
      '_jobId': 'JOB_' + Date.now(),
      '_hidden': 'true'
    };

    Object.keys(props).forEach(name => {
      let input = form.querySelector(`input[name="properties[${name}]"]`);
      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = `properties[${name}]`;
        form.appendChild(input);
      }
      input.value = props[name];
    });
  }
})();
</script>
