    .col-lg-45 { flex: 0 0 45%; max-width: 45%; }
  }
  @media (min-width: 768px) and (max-width: 991px) {
    .col-md-20 { flex: 0 0 20%; max-width: 20%; }
    .col-md-40 { flex: 0 0 40%; max-width: 40%; }
    .col-md-45 { flex: 0 0 45%; max-width: 45%; }
  }
</style>

