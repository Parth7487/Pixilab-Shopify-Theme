{% comment %}
  Design Systems - Departments Section
  Version: 2.0 - Enhanced with Overlay & Typography Controls
{% endcomment %}

{% style %}
  /* ========================================
     DESIGN SYSTEMS SECTION
     ======================================== */
  
  .design-systems-{{ section.id }} {
    width: 100%;
    max-width: {% if section.settings.full_width %}100%{% else %}100vw{% endif %};
    overflow-x: hidden;
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }
  
  @media (min-width: 1024px) {
    .design-systems-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
  
  /* Container */
  .design-systems__container-{{ section.id }} {
    width: 100%;
    max-width: {% if section.settings.full_width %}100%{% else %}2200px{% endif %};
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
  }
  
  @media (min-width: 640px) {
    .design-systems__container-{{ section.id }} {
      padding: 0 24px;
    }
  }
  
  @media (min-width: 1024px) {
    .design-systems__container-{{ section.id }} {
      padding: 0 48px;
    }
  }
  
  @media (min-width: 1280px) {
    .design-systems__container-{{ section.id }} {
      padding: 0 80px;
    }
  }
  
  /* ========================================
     HEADER
     ======================================== */
  
  .design-systems__header-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 40px;
  }
  
  @media (min-width: 768px) {
    .design-systems__header-{{ section.id }} {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 0;
      margin-bottom: 64px;
    }
  }
  
  /* Title Block */
  .design-systems__title-block-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  
  .design-systems__label-{{ section.id }} {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: rgba(0, 0, 0, 0.4);
  }
  
  @media (min-width: 640px) {
    .design-systems__label-{{ section.id }} {
      font-size: 11px;
    }
  }
  
  .design-systems__heading-{{ section.id }} {
    font-size: 36px;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }
  
  @media (min-width: 640px) {
    .design-systems__heading-{{ section.id }} {
      font-size: 48px;
    }
  }
  
  @media (min-width: 768px) {
    .design-systems__heading-{{ section.id }} {
      font-size: 56px;
    }
  }
  
  .design-systems__heading-accent-{{ section.id }} {
    color: {{ section.settings.heading_accent_color }};
  }
  
  /* CTA Button */
  .design-systems__cta-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: rgba(0, 0, 0, 0.4);
    text-decoration: none;
    cursor: pointer;
    transition: color 200ms ease;
  }
  
  .design-systems__cta-{{ section.id }}:hover {
    color: {{ section.settings.heading_accent_color }};
  }
  
  .design-systems__cta-{{ section.id }} svg {
    transition: transform 200ms ease;
  }
  
  .design-systems__cta-{{ section.id }}:hover svg {
    transform: translateX(4px);
  }
  
  /* ========================================
     CARDS GRID - DESKTOP
     ======================================== */
  
  .design-systems__grid-{{ section.id }} {
    display: none;
  }
  
  @media (min-width: 768px) {
    .design-systems__grid-{{ section.id }} {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }
  
  @media (min-width: 1024px) {
    .design-systems__grid-{{ section.id }} {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  
  /* ========================================
     MOBILE LAYOUT - GRID (2 COLUMNS)
     ======================================== */
  
  .design-systems__mobile-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  
  @media (min-width: 768px) {
    .design-systems__mobile-grid-{{ section.id }} {
      display: none;
    }
  }
  
  /* ========================================
     MOBILE LAYOUT - SLIDER
     ======================================== */
  
  .design-systems__mobile-slider-{{ section.id }} {
    display: block;
    position: relative;
    overflow: hidden;
  }
  
  @media (min-width: 768px) {
    .design-systems__mobile-slider-{{ section.id }} {
      display: none;
    }
  }
  
  .design-systems__slider-track-{{ section.id }} {
    display: flex;
    transition: transform 300ms ease-out;
    touch-action: pan-y pinch-zoom;
  }
  
  .design-systems__slider-slide-{{ section.id }} {
    flex-shrink: 0;
    padding-right: 12px;
    box-sizing: border-box;
  }
  
  /* Cards per view options */
  .design-systems__slider-slide-{{ section.id }}.cards-1 {
    width: 100%;
  }
  
  .design-systems__slider-slide-{{ section.id }}.cards-1-2 {
    width: 85%;
  }
  
  .design-systems__slider-slide-{{ section.id }}.cards-2 {
    width: 50%;
  }
  
  /* Slider Indicators */
  .design-systems__indicators-{{ section.id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }
  
  .design-systems__indicators-{{ section.id }}.hidden {
    display: none;
  }
  
  .design-systems__indicator-{{ section.id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.2);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 300ms ease;
  }
  
  .design-systems__indicator-{{ section.id }}.active {
    width: 24px;
    border-radius: 4px;
    background-color: {{ section.settings.heading_accent_color }};
  }
  
  @media (min-width: 768px) {
    .design-systems__indicators-{{ section.id }} {
      display: none;
    }
  }
  
  /* ========================================
     INDIVIDUAL CARD
     ======================================== */
  
  .design-systems__card-{{ section.id }} {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 24px;
    background-color: #F9FAFB;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    transition: box-shadow 500ms ease;
    display: block;
  }
  
  @media (min-width: 640px) {
    .design-systems__card-{{ section.id }} {
      border-radius: 32px;
    }
  }
  
  @media (min-width: 1024px) {
    .design-systems__card-{{ section.id }} {
      border-radius: 40px;
    }
  }
  
  .design-systems__card-{{ section.id }}:hover {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
  
  /* Card Image */
  .design-systems__card-image-{{ section.id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(50%);
    transform: scale(1);
    transition: filter 700ms ease, transform 700ms ease;
  }
  
  .design-systems__card-{{ section.id }}:hover .design-systems__card-image-{{ section.id }} {
    filter: grayscale(0%);
    transform: scale(1.05);
  }
  
  /* Card Placeholder (when no image) */
  .design-systems__card-placeholder-{{ section.id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #E5E7EB 0%, #F3F4F6 100%);
  }
  
  /* ========================================
     GRADIENT OVERLAY - ENHANCED
     ======================================== */
  
  .design-systems__card-overlay-{{ section.id }} {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 400ms ease;
    
    {% if section.settings.overlay_type == 'solid' %}
      background: {{ section.settings.overlay_solid_color }};
    {% else %}
      background: linear-gradient(
        {{ section.settings.overlay_gradient_angle }}deg,
        {{ section.settings.overlay_gradient_color_1 }} 0%,
        {{ section.settings.overlay_gradient_color_2 }} 100%
      );
    {% endif %}
    
    opacity: {{ section.settings.overlay_opacity_default | divided_by: 100.0 }};
  }
  
  .design-systems__card-{{ section.id }}:hover .design-systems__card-overlay-{{ section.id }} {
    opacity: {{ section.settings.overlay_opacity_hover | divided_by: 100.0 }};
  }
  
  /* Card Content */
  .design-systems__card-content-{{ section.id }} {
    position: absolute;
    inset: 0;
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  
  @media (min-width: 640px) {
    .design-systems__card-content-{{ section.id }} {
      padding: 28px;
    }
  }
  
  @media (min-width: 1024px) {
    .design-systems__card-content-{{ section.id }} {
      padding: 32px;
    }
  }
  
  /* ========================================
     CARD TITLE - ENHANCED
     ======================================== */
  
  .design-systems__card-title-{{ section.id }} {
    font-size: {{ section.settings.title_size_mobile }}px;
    font-weight: {{ section.settings.title_font_weight }};
    line-height: {{ section.settings.title_line_height }};
    color: {{ section.settings.title_color }};
    margin: 0 0 6px 0;
    transition: color 300ms ease;
    
    {% if section.settings.text_shadow_enabled %}
      text-shadow: 0 2px {{ section.settings.text_shadow_intensity }}px rgba(0, 0, 0, 0.5);
    {% endif %}
  }
  
  @media (min-width: 640px) {
    .design-systems__card-title-{{ section.id }} {
      margin-bottom: 12px;
    }
  }
  
  @media (min-width: 1024px) {
    .design-systems__card-title-{{ section.id }} {
      font-size: {{ section.settings.title_size_desktop }}px;
    }
  }
  
  .design-systems__card-{{ section.id }}:hover .design-systems__card-title-{{ section.id }} {
    color: {{ section.settings.title_hover_color }};
  }
  
  /* ========================================
     CARD DESCRIPTION - ENHANCED
     ======================================== */
  
  .design-systems__card-description-{{ section.id }} {
    font-size: {{ section.settings.description_size_mobile }}px;
    font-weight: {{ section.settings.description_font_weight }};
    line-height: {{ section.settings.description_line_height }};
    color: {{ section.settings.description_color }};
    margin: 0 0 16px 0;
    transition: color 300ms ease, opacity 200ms ease;
    
    /* Line Clamp */
    display: -webkit-box;
    -webkit-line-clamp: {{ section.settings.description_line_clamp }};
    -webkit-box-orient: vertical;
    overflow: hidden;
    
    {% if section.settings.text_shadow_enabled %}
      text-shadow: 0 1px {{ section.settings.text_shadow_intensity | divided_by: 2 }}px rgba(0, 0, 0, 0.4);
    {% endif %}
  }
  
  @media (min-width: 640px) {
    .design-systems__card-description-{{ section.id }} {
      margin-bottom: 32px;
    }
  }
  
  @media (min-width: 1024px) {
    .design-systems__card-description-{{ section.id }} {
      font-size: {{ section.settings.description_size_desktop }}px;
    }
  }
  
  .design-systems__card-{{ section.id }}:hover .design-systems__card-description-{{ section.id }} {
    color: {{ section.settings.description_hover_color }};
    opacity: 1;
  }
  
  /* Arrow Button */
  .design-systems__card-button-{{ section.id }} {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background-color: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 300ms ease, border-color 300ms ease;
  }
  
  @media (min-width: 640px) {
    .design-systems__card-button-{{ section.id }} {
      width: 40px;
      height: 40px;
    }
  }
  
  .design-systems__card-button-{{ section.id }} svg {
    width: 12px;
    height: 12px;
    color: #FFFFFF;
    transition: color 300ms ease;
  }
  
  @media (min-width: 640px) {
    .design-systems__card-button-{{ section.id }} svg {
      width: 16px;
      height: 16px;
    }
  }
  
  .design-systems__card-{{ section.id }}:hover .design-systems__card-button-{{ section.id }} {
    background-color: #FFFFFF;
    border-color: #FFFFFF;
  }
  
  .design-systems__card-{{ section.id }}:hover .design-systems__card-button-{{ section.id }} svg {
    color: #000000;
  }
{% endstyle %}

<section class="design-systems-{{ section.id }}" id="departments" {{ section.shopify_attributes }}>
  <div class="design-systems__container-{{ section.id }}">
    
    <!-- Header -->
    <header class="design-systems__header-{{ section.id }}">
      <div class="design-systems__title-block-{{ section.id }}">
        {% if section.settings.label_text != blank %}
          <span class="design-systems__label-{{ section.id }}">{{ section.settings.label_text }}</span>
        {% endif %}
        {% if section.settings.heading_word_1 != blank or section.settings.heading_word_2 != blank %}
          <h2 class="design-systems__heading-{{ section.id }}">
            {{ section.settings.heading_word_1 }} 
            <span class="design-systems__heading-accent-{{ section.id }}">{{ section.settings.heading_word_2 }}</span>
          </h2>
        {% endif %}
      </div>
      
      {% if section.settings.cta_link != blank and section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_link }}" class="design-systems__cta-{{ section.id }}">
          {{ section.settings.cta_text }}
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% endif %}
    </header>
    
    <!-- Desktop Grid (768px+) -->
    <div class="design-systems__grid-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.type == 'department_card' %}
          <a href="{{ block.settings.link | default: '#' }}" class="design-systems__card-{{ section.id }}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.title | escape }}"
                class="design-systems__card-image-{{ section.id }}"
                loading="lazy"
                width="600"
                height="800"
              >
            {% else %}
              <div class="design-systems__card-placeholder-{{ section.id }}"></div>
            {% endif %}
            
            <div class="design-systems__card-overlay-{{ section.id }}"></div>
            
            <div class="design-systems__card-content-{{ section.id }}">
              <h3 class="design-systems__card-title-{{ section.id }}">{{ block.settings.title }}</h3>
              <p class="design-systems__card-description-{{ section.id }}">{{ block.settings.description }}</p>
              
              <div class="design-systems__card-button-{{ section.id }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
    
    <!-- Mobile Grid (2 columns) -->
    {% if section.settings.mobile_layout == 'grid' %}
      <div class="design-systems__mobile-grid-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.type == 'department_card' %}
            <a href="{{ block.settings.link | default: '#' }}" class="design-systems__card-{{ section.id }}" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <img 
                  src="{{ block.settings.image | image_url: width: 400 }}"
                  alt="{{ block.settings.title | escape }}"
                  class="design-systems__card-image-{{ section.id }}"
                  loading="lazy"
                  width="400"
                  height="533"
                >
              {% else %}
                <div class="design-systems__card-placeholder-{{ section.id }}"></div>
              {% endif %}
              
              <div class="design-systems__card-overlay-{{ section.id }}"></div>
              
              <div class="design-systems__card-content-{{ section.id }}">
                <h3 class="design-systems__card-title-{{ section.id }}">{{ block.settings.title }}</h3>
                <p class="design-systems__card-description-{{ section.id }}">{{ block.settings.description }}</p>
                
                <div class="design-systems__card-button-{{ section.id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
    
    <!-- Mobile Slider -->
    {% if section.settings.mobile_layout == 'slider' %}
      <div class="design-systems__mobile-slider-{{ section.id }}" id="designSystemsSlider-{{ section.id }}">
        <div class="design-systems__slider-track-{{ section.id }}" id="designSystemsTrack-{{ section.id }}">
          {% for block in section.blocks %}
            {% if block.type == 'department_card' %}
              <div class="design-systems__slider-slide-{{ section.id }} cards-{{ section.settings.cards_per_view }}" {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link | default: '#' }}" class="design-systems__card-{{ section.id }}">
                  {% if block.settings.image != blank %}
                    <img 
                      src="{{ block.settings.image | image_url: width: 400 }}"
                      alt="{{ block.settings.title | escape }}"
                      class="design-systems__card-image-{{ section.id }}"
                      loading="lazy"
                      width="400"
                      height="533"
                    >
                  {% else %}
                    <div class="design-systems__card-placeholder-{{ section.id }}"></div>
                  {% endif %}
                  
                  <div class="design-systems__card-overlay-{{ section.id }}"></div>
                  
                  <div class="design-systems__card-content-{{ section.id }}">
                    <h3 class="design-systems__card-title-{{ section.id }}">{{ block.settings.title }}</h3>
                    <p class="design-systems__card-description-{{ section.id }}">{{ block.settings.description }}</p>
                    
                    <div class="design-systems__card-button-{{ section.id }}">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </div>
                  </div>
                </a>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        
        {% if section.settings.show_indicators %}
          <div class="design-systems__indicators-{{ section.id }}" id="designSystemsIndicators-{{ section.id }}"></div>
        {% endif %}
      </div>
    {% endif %}
    
  </div>
</section>

{% if section.settings.mobile_layout == 'slider' %}
<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const slider = document.getElementById('designSystemsSlider-' + sectionId);
    const track = document.getElementById('designSystemsTrack-' + sectionId);
    const indicatorsContainer = document.getElementById('designSystemsIndicators-' + sectionId);
    
    if (!slider || !track) return;
    
    const slides = track.querySelectorAll('.design-systems__slider-slide-{{ section.id }}');
    const cardsPerView = '{{ section.settings.cards_per_view }}';
    const showIndicators = {{ section.settings.show_indicators }};
    
    let currentSlide = 0;
    let touchStartX = 0;
    let touchEndX = 0;
    let isDragging = false;
    let startTranslate = 0;
    let currentTranslate = 0;
    const swipeThreshold = 50;
    
    function getSlideWidth() {
      if (slides.length === 0) return 0;
      return slides[0].offsetWidth;
    }
    
    function getMaxSlide() {
      let visibleCards = 1;
      if (cardsPerView === '1-2') visibleCards = 1.2;
      if (cardsPerView === '2') visibleCards = 2;
      
      return Math.max(0, slides.length - Math.floor(visibleCards));
    }
    
    function createIndicators() {
      if (!showIndicators || !indicatorsContainer) return;
      
      const maxSlide = getMaxSlide();
      
      for (let i = 0; i <= maxSlide; i++) {
        const indicator = document.createElement('button');
        indicator.className = 'design-systems__indicator-{{ section.id }}';
        indicator.setAttribute('aria-label', 'Go to slide ' + (i + 1));
        
        if (i === 0) {
          indicator.classList.add('active');
        }
        
        indicator.addEventListener('click', () => {
          goToSlide(i);
        });
        
        indicatorsContainer.appendChild(indicator);
      }
    }
    
    function updateIndicators() {
      if (!indicatorsContainer) return;
      
      const indicators = indicatorsContainer.querySelectorAll('.design-systems__indicator-{{ section.id }}');
      indicators.forEach((indicator, index) => {
        if (index === currentSlide) {
          indicator.classList.add('active');
        } else {
          indicator.classList.remove('active');
        }
      });
    }
    
    function goToSlide(index) {
      const maxSlide = getMaxSlide();
      currentSlide = Math.max(0, Math.min(index, maxSlide));
      
      const slideWidth = getSlideWidth();
      currentTranslate = -currentSlide * slideWidth;
      
      track.style.transform = `translateX(${currentTranslate}px)`;
      updateIndicators();
    }
    
    function handleTouchStart(e) {
      isDragging = true;
      touchStartX = e.touches[0].clientX;
      startTranslate = currentTranslate;
      track.style.transition = 'none';
    }
    
    function handleTouchMove(e) {
      if (!isDragging) return;
      
      touchEndX = e.touches[0].clientX;
      const diff = touchEndX - touchStartX;
      currentTranslate = startTranslate + diff;
      
      track.style.transform = `translateX(${currentTranslate}px)`;
    }
    
    function handleTouchEnd() {
      if (!isDragging) return;
      
      isDragging = false;
      track.style.transition = 'transform 300ms ease-out';
      
      const diff = touchEndX - touchStartX;
      
      if (Math.abs(diff) > swipeThreshold) {
        if (diff < 0) {
          goToSlide(currentSlide + 1);
        } else {
          goToSlide(currentSlide - 1);
        }
      } else {
        goToSlide(currentSlide);
      }
      
      touchStartX = 0;
      touchEndX = 0;
    }
    
    if (slides.length > 0) {
      createIndicators();
      
      track.addEventListener('touchstart', handleTouchStart, { passive: true });
      track.addEventListener('touchmove', handleTouchMove, { passive: true });
      track.addEventListener('touchend', handleTouchEnd);
      
      window.addEventListener('resize', () => {
        goToSlide(currentSlide);
      });
    }
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Design Systems",
  "tag": "section",
  "class": "section-design-systems",
  "settings": [
    {
      "type": "header",
      "content": "━━━━━ LAYOUT SETTINGS ━━━━━"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding - Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top Padding (Mobile)",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom Padding (Mobile)",
      "min": 0,
      "max": 150,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Padding - Desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top Padding (Desktop)",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom Padding (Desktop)",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "header",
      "content": "━━━━━ MOBILE LAYOUT ━━━━━"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid (2 Columns)"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "cards_per_view",
      "label": "Cards Per View (Slider)",
      "options": [
        {
          "value": "1",
          "label": "1 Card"
        },
        {
          "value": "1-2",
          "label": "1.2 Cards (Peek Next)"
        },
        {
          "value": "2",
          "label": "2 Cards"
        }
      ],
      "default": "1-2",
      "info": "Only applies when Slider is selected"
    },
    {
      "type": "checkbox",
      "id": "show_indicators",
      "label": "Show Indicators (Slider)",
      "default": true,
      "info": "Only applies when Slider is selected"
    },
    {
      "type": "header",
      "content": "━━━━━ HEADER CONTENT ━━━━━"
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label Text",
      "default": "DEPARTMENTS"
    },
    {
      "type": "text",
      "id": "heading_word_1",
      "label": "Heading Word 1",
      "default": "Design"
    },
    {
      "type": "text",
      "id": "heading_word_2",
      "label": "Heading Word 2 (Accent Color)",
      "default": "Systems."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_accent_color",
      "label": "Heading Accent Color",
      "default": "#00B9F1"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "OUR ARCHIVE"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "header",
      "content": "━━━━━ CARD OVERLAY ━━━━━"
    },
    {
      "type": "select",
      "id": "overlay_type",
      "label": "Overlay Type",
      "options": [
        {
          "value": "solid",
          "label": "Solid Color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "gradient"
    },
    {
      "type": "color",
      "id": "overlay_solid_color",
      "label": "Solid Overlay Color",
      "default": "#000000",
      "info": "Used when Overlay Type is 'Solid Color'"
    },
    {
      "type": "header",
      "content": "Gradient Settings"
    },
    {
      "type": "color",
      "id": "overlay_gradient_color_1",
      "label": "Gradient Color 1 (Start)",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "overlay_gradient_color_2",
      "label": "Gradient Color 2 (End)",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "range",
      "id": "overlay_gradient_angle",
      "label": "Gradient Angle",
      "min": 0,
      "max": 360,
      "step": 5,
      "unit": "°",
      "default": 0,
      "info": "0° = Bottom to Top, 90° = Left to Right, 180° = Top to Bottom"
    },
    {
      "type": "header",
      "content": "Overlay Opacity"
    },
    {
      "type": "range",
      "id": "overlay_opacity_default",
      "label": "Default Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "range",
      "id": "overlay_opacity_hover",
      "label": "Hover Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80
    },
    {
      "type": "header",
      "content": "━━━━━ CARD TITLE ━━━━━"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "title_hover_color",
      "label": "Title Hover Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Title Size"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Title Size (Mobile)",
      "min": 14,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Title Size (Desktop)",
      "min": 14,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Title Typography"
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Title Font Weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra Bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ],
      "default": "900"
    },
    {
      "type": "range",
      "id": "title_line_height",
      "label": "Title Line Height",
      "min": 0.8,
      "max": 2.0,
      "step": 0.1,
      "default": 1.1
    },
    {
      "type": "header",
      "content": "━━━━━ CARD DESCRIPTION ━━━━━"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "rgba(255, 255, 255, 0.6)"
    },
    {
      "type": "color",
      "id": "description_hover_color",
      "label": "Description Hover Color",
      "default": "rgba(255, 255, 255, 0.9)"
    },
    {
      "type": "header",
      "content": "Description Size"
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "label": "Description Size (Mobile)",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "description_size_desktop",
      "label": "Description Size (Desktop)",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Description Typography"
    },
    {
      "type": "select",
      "id": "description_font_weight",
      "label": "Description Font Weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Description Line Height",
      "min": 1.0,
      "max": 2.5,
      "step": 0.1,
      "default": 1.5
    },
    {
      "type": "range",
      "id": "description_line_clamp",
      "label": "Max Lines (Line Clamp)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "info": "Limit the number of visible lines"
    },
    {
      "type": "header",
      "content": "━━━━━ TEXT EFFECTS ━━━━━"
    },
    {
      "type": "checkbox",
      "id": "text_shadow_enabled",
      "label": "Enable Text Shadow",
      "default": true,
      "info": "Improves readability on images"
    },
    {
      "type": "range",
      "id": "text_shadow_intensity",
      "label": "Text Shadow Intensity",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8,
      "info": "Blur radius of the shadow"
    }
  ],
  "blocks": [
    {
      "type": "department_card",
      "name": "Department Card",
      "limit": 10,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Department"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Short description of this department."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Design Systems",
      "blocks": [
        {
          "type": "department_card",
          "settings": {
            "title": "Branding",
            "description": "Industrial-grade branding systems engineered for high impact."
          }
        },
        {
          "type": "department_card",
          "settings": {
            "title": "Print Media",
            "description": "High-fidelity print solutions for physical presence."
          }
        },
        {
          "type": "department_card",
          "settings": {
            "title": "Web Design",
            "description": "Immersive digital experiences and ecommerce."
          }
        },
        {
          "type": "department_card",
          "settings": {
            "title": "Marketing",
            "description": "Data-driven growth strategies and analytics."
          }
        },
        {
          "type": "department_card",
          "settings": {
            "title": "Signage",
            "description": "Large format displays and architectural graphics."
          }
        }
      ]
    }
  ]
}
{% endschema %}