{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-design-systems-{{ai_gen_id}} {
    display: block;
    width: 100%;
    background: {{ block.settings.section_bg }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-design-systems-container-{{ai_gen_id}} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-design-systems-header-{{ai_gen_id}} {
    text-align: center;
    margin-bottom: 60px;
    opacity: 0;
    animation: ai-fadeInUp-{{ai_gen_id}} 0.8s ease forwards;
  }

  .ai-design-systems-title-{{ai_gen_id}} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 20px;
    letter-spacing: -0.5px;
  }

  .ai-design-systems-subtitle-{{ai_gen_id}} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-design-systems-grid-{{ai_gen_id}} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-bottom: 60px;
  }

  .ai-design-card-{{ai_gen_id}} {
    background: {{ block.settings.card_bg }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 40px 30px;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0;
    transform: translateY(30px);
    animation: ai-fadeInUp-{{ai_gen_id}} 0.6s ease forwards;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .ai-design-card-{{ai_gen_id}}:nth-child(1) { animation-delay: 0.1s; }
  .ai-design-card-{{ai_gen_id}}:nth-child(2) { animation-delay: 0.2s; }
  .ai-design-card-{{ai_gen_id}}:nth-child(3) { animation-delay: 0.3s; }
  .ai-design-card-{{ai_gen_id}}:nth-child(4) { animation-delay: 0.4s; }
  .ai-design-card-{{ai_gen_id}}:nth-child(5) { animation-delay: 0.5s; }
  .ai-design-card-{{ai_gen_id}}:nth-child(6) { animation-delay: 0.6s; }
  .ai-design-card-{{ai_gen_id}}:nth-child(7) { animation-delay: 0.7s; }
  .ai-design-card-{{ai_gen_id}}:nth-child(8) { animation-delay: 0.8s; }

  .ai-design-card-{{ai_gen_id}}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: {{ block.settings.accent_color }};
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease;
  }

  .ai-design-card-{{ai_gen_id}}:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .ai-design-card-{{ai_gen_id}}:hover::before {
    transform: scaleX(1);
  }

  .ai-design-card-icon-{{ai_gen_id}} {
    width: 70px;
    height: 70px;
    background: {{ block.settings.icon_bg }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
    transition: all 0.4s ease;
  }

  .ai-design-card-{{ai_gen_id}}:hover .ai-design-card-icon-{{ai_gen_id}} {
    transform: scale(1.1) rotate(5deg);
    background: {{ block.settings.accent_color }};
  }

  .ai-design-card-icon-{{ai_gen_id}} svg {
    width: 35px;
    height: 35px;
    fill: {{ block.settings.icon_color }};
    transition: fill 0.4s ease;
  }

  .ai-design-card-{{ai_gen_id}}:hover .ai-design-card-icon-{{ai_gen_id}} svg {
    fill: #ffffff;
  }

  .ai-design-card-title-{{ai_gen_id}} {
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 15px;
  }

  .ai-design-card-desc-{{ai_gen_id}} {
    font-size: {{ block.settings.card_desc_size }}px;
    color: {{ block.settings.card_desc_color }};
    line-height: 1.7;
    margin: 0;
  }

  .ai-design-cta-{{ai_gen_id}} {
    text-align: center;
    opacity: 0;
    animation: ai-fadeInUp-{{ai_gen_id}} 0.8s ease forwards 0.6s;
  }

  .ai-design-cta-btn-{{ai_gen_id}} {
    display: inline-block;
    padding: 18px 50px;
    background: {{ block.settings.cta_bg }};
    color: {{ block.settings.cta_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: {{ block.settings.cta_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .ai-design-cta-btn-{{ai_gen_id}}::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: {{ block.settings.cta_hover_bg }};
    transition: left 0.4s ease;
    z-index: -1;
  }

  .ai-design-cta-btn-{{ai_gen_id}}:hover {
    color: {{ block.settings.cta_hover_color }};
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .ai-design-cta-btn-{{ai_gen_id}}:hover::before {
    left: 0;
  }

  .ai-design-dots-{{ai_gen_id}} {
    display: none;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
    padding: 10px 0;
  }

  .ai-design-dot-{{ai_gen_id}} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d0d0d0;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-design-dot-{{ai_gen_id}}.active {
    background: {{ block.settings.accent_color }};
    transform: scale(1.3);
  }

  @keyframes ai-fadeInUp-{{ai_gen_id}} {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 768px) {
    .ai-design-systems-title-{{ai_gen_id}} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-design-card-{{ai_gen_id}} {
      padding: 30px 20px;
    }

    {% if block.settings.enable_mobile_slider %}
      .ai-design-systems-grid-{{ai_gen_id}} {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        gap: 20px;
        padding-bottom: 10px;
        scrollbar-width: none;
        -ms-overflow-style: none;
      }

      .ai-design-systems-grid-{{ai_gen_id}}::-webkit-scrollbar {
        display: none;
      }

      .ai-design-card-{{ai_gen_id}} {
        min-width: 280px;
        flex-shrink: 0;
        scroll-snap-align: start;
      }

      .ai-design-dots-{{ai_gen_id}} {
        display: flex;
      }
    {% else %}
      .ai-design-systems-grid-{{ai_gen_id}} {
        grid-template-columns: 1fr;
        gap: 20px;
      }
    {% endif %}
  }
{% endstyle %}

<design-systems-{{ai_gen_id}} class="ai-design-systems-{{ai_gen_id}}" {{ block.shopify_attributes }}>
  <div class="ai-design-systems-container-{{ai_gen_id}}">
    <div class="ai-design-systems-header-{{ai_gen_id}}">
      <h2 class="ai-design-systems-title-{{ai_gen_id}}">{{ block.settings.main_title }}</h2>
      <p class="ai-design-systems-subtitle-{{ai_gen_id}}">{{ block.settings.main_subtitle }}</p>
    </div>

    <div class="ai-design-systems-grid-{{ai_gen_id}}" data-slider>
      {% for i in (1..8) %}
        {% assign card_enabled = 'card_' | append: i | append: '_enabled' %}
        {% assign card_icon = 'card_' | append: i | append: '_icon' %}
        {% assign card_title = 'card_' | append: i | append: '_title' %}
        {% assign card_desc = 'card_' | append: i | append: '_desc' %}
        
        {% if block.settings[card_enabled] %}
          <div class="ai-design-card-{{ai_gen_id}}" data-card>
            <div class="ai-design-card-icon-{{ai_gen_id}}">
              {{ block.settings[card_icon] }}
            </div>
            <h3 class="ai-design-card-title-{{ai_gen_id}}">{{ block.settings[card_title] }}</h3>
            <p class="ai-design-card-desc-{{ai_gen_id}}">{{ block.settings[card_desc] }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-design-dots-{{ai_gen_id}}" data-dots></div>

    <div class="ai-design-cta-{{ai_gen_id}}">
      <a href="{{ block.settings.cta_link }}" class="ai-design-cta-btn-{{ai_gen_id}}">
        {{ block.settings.cta_text }}
      </a>
    </div>
  </div>
</design-systems-{{ai_gen_id}}>

<script>
  (function() {
    class DesignSystems{{ai_gen_id}} extends HTMLElement {
      constructor() {
        super();
        this.slider = null;
        this.dotsContainer = null;
        this.cards = [];
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.initParallax();
        this.initMobileSlider();
      }

      initParallax() {
        const cards = this.querySelectorAll('.ai-design-card-{{ai_gen_id}}');
        
        window.addEventListener('scroll', () => {
          const scrolled = window.pageYOffset;
          const rect = this.getBoundingClientRect();
          
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            cards.forEach((card, index) => {
              const speed = 0.5 + (index * 0.1);
              const yPos = -(scrolled * speed * 0.05);
              card.style.transform = `translateY(${yPos}px)`;
            });
          }
        });
      }

      initMobileSlider() {
        if (window.innerWidth > 768) return;

        this.slider = this.querySelector('[data-slider]');
        this.dotsContainer = this.querySelector('[data-dots]');
        this.cards = Array.from(this.querySelectorAll('[data-card]'));

        if (!this.slider || this.cards.length === 0) return;

        this.createDots();
        this.updateActiveDot();

        this.slider.addEventListener('scroll', () => {
          this.handleScroll();
        });
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        this.cards.forEach((card, index) => {
          const dot = document.createElement('div');
          dot.className = 'ai-design-dot-{{ai_gen_id}}';
          dot.addEventListener('click', () => this.scrollToCard(index));
          this.dotsContainer.appendChild(dot);
        });
      }

      handleScroll() {
        const scrollLeft = this.slider.scrollLeft;
        const cardWidth = this.cards[0].offsetWidth + 20;
        this.currentIndex = Math.round(scrollLeft / cardWidth);
        this.updateActiveDot();
      }

      updateActiveDot() {
        const dots = this.dotsContainer.querySelectorAll('.ai-design-dot-{{ai_gen_id}}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      scrollToCard(index) {
        const cardWidth = this.cards[0].offsetWidth + 20;
        this.slider.scrollTo({
          left: cardWidth * index,
          behavior: 'smooth'
        });
      }
    }

    customElements.define('design-systems-{{ai_gen_id}}', DesignSystems{{ai_gen_id}});
  })();
</script>

