{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tradeshow-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background: {{ block.settings.background_color }};
    position: relative;
    overflow: hidden;
  }

  .ai-tradeshow-animated-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.05;
    pointer-events: none;
    background: 
      radial-gradient(circle at 20% 50%, {{ block.settings.accent_color }}40 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, {{ block.settings.accent_color_secondary }}40 0%, transparent 50%),
      radial-gradient(circle at 40% 20%, {{ block.settings.accent_color }}30 0%, transparent 50%);
    animation: ai-tradeshow-bg-float-{{ ai_gen_id }} 20s ease-in-out infinite;
  }

  @keyframes ai-tradeshow-bg-float-{{ ai_gen_id }} {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -30px) scale(1.1); }
    66% { transform: translate(-20px, 20px) scale(0.9); }
  }

  .ai-tradeshow-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 1;
  }

  .ai-tradeshow-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.header_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
    position: relative;
  }

  .ai-tradeshow-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    text-transform: {{ block.settings.title_transform }};
    letter-spacing: 3px;
    position: relative;
    display: inline-block;
    background: linear-gradient(135deg, {{ block.settings.title_color }}, {{ block.settings.accent_color }});
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .ai-tradeshow-title-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    bottom: -15px;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 5px;
    background: linear-gradient(90deg, transparent, {{ block.settings.accent_color }}, {{ block.settings.accent_color_secondary }}, transparent);
    border-radius: 3px;
    animation: ai-tradeshow-line-pulse-{{ ai_gen_id }} 2s ease-in-out infinite;
  }

  @keyframes ai-tradeshow-line-pulse-{{ ai_gen_id }} {
    0%, 100% { width: 100px; opacity: 1; }
    50% { width: 140px; opacity: 0.7; }
  }

  .ai-tradeshow-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.8;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    font-weight: 300;
    opacity: 0;
    animation: ai-tradeshow-fade-in-{{ ai_gen_id }} 1s ease forwards 0.3s;
  }

  @keyframes ai-tradeshow-fade-in-{{ ai_gen_id }} {
    to { opacity: 1; }
  }

  .ai-tradeshow-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-tradeshow-item-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    box-shadow: {{ block.settings.card_shadow }};
    transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    transform-style: preserve-3d;
    perspective: 1000px;
  }

  .ai-tradeshow-item-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(135deg, {{ block.settings.accent_color }}, {{ block.settings.accent_color_secondary }}, {{ block.settings.accent_color }});
    opacity: 0;
    transition: opacity 0.6s ease;
    z-index: -1;
    border-radius: {{ block.settings.card_border_radius }}px;
    filter: blur(10px);
  }

  .ai-tradeshow-item-{{ ai_gen_id }}:hover::before {
    opacity: 0.6;
  }

  .ai-tradeshow-item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px) rotateX(2deg);
    box-shadow: {{ block.settings.card_hover_shadow }};
    border-color: {{ block.settings.accent_color }};
  }

  .ai-tradeshow-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-top: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background: linear-gradient(135deg, #f5f5f5, #e8e8e8);
  }

  .ai-tradeshow-image-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, {{ block.settings.accent_color }}90, {{ block.settings.accent_color_secondary }}90);
    opacity: 0;
    transition: opacity 0.6s ease;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-tradeshow-item-{{ ai_gen_id }}:hover .ai-tradeshow-image-overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-tradeshow-overlay-icon-{{ ai_gen_id }} {
    width: 60px;
    height: 60px;
    color: #ffffff;
    transform: scale(0) rotate(-180deg);
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .ai-tradeshow-item-{{ ai_gen_id }}:hover .ai-tradeshow-overlay-icon-{{ ai_gen_id }} {
    transform: scale(1) rotate(0deg);
  }

  .ai-tradeshow-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
    filter: brightness(1) saturate(1);
  }

  .ai-tradeshow-item-{{ ai_gen_id }}:hover .ai-tradeshow-image-{{ ai_gen_id }} {
    transform: scale(1.15) rotate(2deg);
    filter: brightness(1.2) saturate(1.3);
  }

  .ai-tradeshow-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f5f5f5, #e8e8e8);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-tradeshow-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.2;
  }

  .ai-tradeshow-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    background: linear-gradient(135deg, {{ block.settings.badge_background }}, {{ block.settings.badge_background_secondary }});
    color: {{ block.settings.badge_text_color }};
    padding: 12px 24px;
    border-radius: 50px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    z-index: 3;
    box-shadow: 0 8px 25px rgba(0,0,0,0.3);
    animation: ai-tradeshow-badge-float-{{ ai_gen_id }} 3s ease-in-out infinite;
    backdrop-filter: blur(10px);
  }

  @keyframes ai-tradeshow-badge-float-{{ ai_gen_id }} {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-8px) scale(1.05); }
  }

  .ai-tradeshow-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    position: relative;
    z-index: 2;
    background: linear-gradient(180deg, transparent, {{ block.settings.card_background }});
  }

  .ai-tradeshow-item-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_title_size }}px;
    font-weight: {{ block.settings.item_title_weight }};
    color: {{ block.settings.item_title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.4;
    transition: all 0.4s ease;
    position: relative;
    padding-left: 20px;
  }

  .ai-tradeshow-item-title-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 5px;
    height: 0;
    background: linear-gradient(180deg, {{ block.settings.accent_color }}, {{ block.settings.accent_color_secondary }});
    border-radius: 3px;
    transition: height 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .ai-tradeshow-item-{{ ai_gen_id }}:hover .ai-tradeshow-item-title-{{ ai_gen_id }}::before {
    height: 100%;
  }

  .ai-tradeshow-item-{{ ai_gen_id }}:hover .ai-tradeshow-item-title-{{ ai_gen_id }} {
    color: {{ block.settings.accent_color }};
    transform: translateX(5px);
  }

  .ai-tradeshow-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.8;
    margin: 0 0 {{ block.settings.description_spacing }}px;
    font-weight: 400;
  }

  .ai-tradeshow-features-{{ ai_gen_id }} {
    display: flex;
    gap: 15px;
    margin-bottom: {{ block.settings.description_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-tradeshow-feature-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: {{ block.settings.feature_color }};
    font-weight: 600;
    padding: 8px 14px;
    background: linear-gradient(135deg, {{ block.settings.accent_color }}10, {{ block.settings.accent_color_secondary }}10);
    border-radius: 20px;
    border: 1px solid {{ block.settings.accent_color }}20;
    transition: all 0.3s ease;
  }

  .ai-tradeshow-feature-{{ ai_gen_id }}:hover {
    background: linear-gradient(135deg, {{ block.settings.accent_color }}20, {{ block.settings.accent_color_secondary }}20);
    transform: translateY(-2px);
  }

  .ai-tradeshow-feature-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    color: {{ block.settings.accent_color }};
  }

  .ai-tradeshow-quote-btn-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    padding: {{ block.settings.button_padding }}px;
    background: linear-gradient(135deg, {{ block.settings.button_background }}, {{ block.settings.button_background_secondary }});
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 700;
    font-size: {{ block.settings.button_font_size }}px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    border: 2px solid transparent;
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  }

  .ai-tradeshow-quote-btn-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: {{ block.settings.button_hover_background }};
    transition: width 0.6s ease, height 0.6s ease, top 0.6s ease, left 0.6s ease;
    transform: translate(-50%, -50%);
    z-index: 0;
  }

  .ai-tradeshow-quote-btn-{{ ai_gen_id }}:hover::before {
    width: 600px;
    height: 600px;
  }

  .ai-tradeshow-quote-btn-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    transition: left 0.7s ease;
    z-index: 1;
  }

  .ai-tradeshow-quote-btn-{{ ai_gen_id }}:hover::after {
    left: 100%;
  }

  .ai-tradeshow-quote-btn-{{ ai_gen_id }}:hover {
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 15px 40px rgba(0,0,0,0.3);
    border-color: {{ block.settings.button_hover_background }};
  }

  .ai-tradeshow-btn-text-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
  }

  .ai-tradeshow-btn-icon-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    display: flex;
    align-items: center;
  }

  .ai-tradeshow-quote-btn-{{ ai_gen_id }}:hover .ai-tradeshow-btn-icon-{{ ai_gen_id }} {
    transform: translateX(8px) rotate(10deg) scale(1.2);
  }

  .ai-tradeshow-stats-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-around;
    padding: 20px 0;
    margin-bottom: 20px;
    border-top: 2px solid {{ block.settings.card_border_color }};
    border-bottom: 2px solid {{ block.settings.card_border_color }};
    background: linear-gradient(135deg, {{ block.settings.accent_color }}05, {{ block.settings.accent_color_secondary }}05);
  }

  .ai-tradeshow-stat-{{ ai_gen_id }} {
    text-align: center;
    flex: 1;
    transition: transform 0.3s ease;
  }

  .ai-tradeshow-stat-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-tradeshow-stat-value-{{ ai_gen_id }} {
    font-size: 22px;
    font-weight: 800;
    background: linear-gradient(135deg, {{ block.settings.accent_color }}, {{ block.settings.accent_color_secondary }});
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: block;
    margin-bottom: 6px;
  }

  .ai-tradeshow-stat-label-{{ ai_gen_id }} {
    font-size: 11px;
    color: {{ block.settings.description_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .ai-tradeshow-corner-shine-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    right: 0;
    width: 100px;
    height: 100px;
    background: linear-gradient(225deg, {{ block.settings.accent_color }}30, transparent);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .ai-tradeshow-item-{{ ai_gen_id }}:hover .ai-tradeshow-corner-shine-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-tradeshow-floating-particles-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }

  .ai-tradeshow-particle-{{ ai_gen_id }} {
    position: absolute;
    width: 4px;
    height: 4px;
    background: {{ block.settings.accent_color }};
    border-radius: 50%;
    opacity: 0;
  }

  .ai-tradeshow-item-{{ ai_gen_id }}:hover .ai-tradeshow-particle-{{ ai_gen_id }} {
    animation: ai-tradeshow-particle-float-{{ ai_gen_id }} 2s ease-out forwards;
  }

  @keyframes ai-tradeshow-particle-float-{{ ai_gen_id }} {
    0% {
      opacity: 0;
      transform: translateY(0) scale(0);
    }
    10% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(-100px) scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .ai-tradeshow-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.8 }}px;
    }

    .ai-tradeshow-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.75 }}px;
    }

    .ai-tradeshow-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.9 }}px;
    }

    .ai-tradeshow-item-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.item_title_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-tradeshow-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.6 }}px;
    }

    .ai-tradeshow-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.6 }}px;
    }

    .ai-tradeshow-subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size | times: 0.85 }}px;
    }

    .ai-tradeshow-item-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.item_title_size | times: 0.85 }}px;
    }

    .ai-tradeshow-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.7 }}px;
    }

    .ai-tradeshow-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 0 {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-tradeshow-badge-{{ ai_gen_id }} {
      top: 10px;
      right: 10px;
      padding: 8px 16px;
      font-size: 9px;
    }

    .ai-tradeshow-features-{{ ai_gen_id }} {
      gap: 10px;
    }

    .ai-tradeshow-feature-{{ ai_gen_id }} {
      font-size: 11px;
      padding: 6px 10px;
    }
  }
{% endstyle %}

<div class="ai-tradeshow-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-tradeshow-animated-bg-{{ ai_gen_id }}"></div>

  <div class="ai-tradeshow-container-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <div class="ai-tradeshow-header-{{ ai_gen_id }}">
        {% if block.settings.section_title != blank %}
          <h2 class="ai-tradeshow-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
        {% endif %}
        {% if block.settings.section_subtitle != blank %}
          <div class="ai-tradeshow-subtitle-{{ ai_gen_id }}">{{ block.settings.section_subtitle }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-tradeshow-grid-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% assign image_key = 'item_image_' | append: i %}
        {% assign title_key = 'item_title_' | append: i %}
        {% assign description_key = 'item_description_' | append: i %}
        {% assign badge_key = 'item_badge_' | append: i %}
        {% assign link_key = 'item_link_' | append: i %}
        {% assign show_key = 'show_item_' | append: i %}

        {% if block.settings[show_key] %}
          <div class="ai-tradeshow-item-{{ ai_gen_id }}">
            <div class="ai-tradeshow-corner-shine-{{ ai_gen_id }}"></div>
            
            <div class="ai-tradeshow-floating-particles-{{ ai_gen_id }}">
              {% for p in (1..6) %}
                {% assign left = p | times: 15 | modulo: 100 %}
                {% assign delay = p | times: 0.1 %}
                <div class="ai-tradeshow-particle-{{ ai_gen_id }}" style="left: {{ left }}%; animation-delay: {{ delay }}s;"></div>
              {% endfor %}
            </div>
            
            <div class="ai-tradeshow-image-wrapper-{{ ai_gen_id }}">
              {% if block.settings[image_key] %}
                <img
                  src="{{ block.settings[image_key] | image_url: width: 800 }}"
                  alt="{{ block.settings[title_key] | escape }}"
                  class="ai-tradeshow-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="800"
                  height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                >
              {% else %}
                <div class="ai-tradeshow-image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              <div class="ai-tradeshow-image-overlay-{{ ai_gen_id }}">
                <svg class="ai-tradeshow-overlay-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.35-4.35"></path>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
              </div>

              {% if block.settings[badge_key] != blank %}
                <div class="ai-tradeshow-badge-{{ ai_gen_id }}">{{ block.settings[badge_key] }}</div>
              {% endif %}
            </div>

            <div class="ai-tradeshow-content-{{ ai_gen_id }}">
              {% if block.settings[title_key] != blank %}
                <h3 class="ai-tradeshow-item-title-{{ ai_gen_id }}">{{ block.settings[title_key] }}</h3>
              {% endif %}

              {% if block.settings[description_key] != blank %}
                <div class="ai-tradeshow-description-{{ ai_gen_id }}">{{ block.settings[description_key] }}</div>
              {% endif %}

              {% if block.settings.show_features %}
                <div class="ai-tradeshow-features-{{ ai_gen_id }}">
                  <div class="ai-tradeshow-feature-{{ ai_gen_id }}">
                    <svg class="ai-tradeshow-feature-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
                    </svg>
                    <span>Fast Setup</span>
                  </div>
                  <div class="ai-tradeshow-feature-{{ ai_gen_id }}">
                    <svg class="ai-tradeshow-feature-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                    </svg>
                    <span>Premium</span>
                  </div>
                  <div class="ai-tradeshow-feature-{{ ai_gen_id }}">
                    <svg class="ai-tradeshow-feature-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Custom</span>
                  </div>
                </div>
              {% endif %}

              {% if block.settings.show_stats %}
                <div class="ai-tradeshow-stats-{{ ai_gen_id }}">
                  <div class="ai-tradeshow-stat-{{ ai_gen_id }}">
                    <span class="ai-tradeshow-stat-value-{{ ai_gen_id }}">24h</span>
                    <span class="ai-tradeshow-stat-label-{{ ai_gen_id }}">Delivery</span>
                  </div>
                  <div class="ai-tradeshow-stat-{{ ai_gen_id }}">
                    <span class="ai-tradeshow-stat-value-{{ ai_gen_id }}">100%</span>
                    <span class="ai-tradeshow-stat-label-{{ ai_gen_id }}">Custom</span>
                  </div>
                  <div class="ai-tradeshow-stat-{{ ai_gen_id }}">
                    <span class="ai-tradeshow-stat-value-{{ ai_gen_id }}">5★</span>
                    <span class="ai-tradeshow-stat-label-{{ ai_gen_id }}">Rated</span>
                  </div>
                </div>
              {% endif %}

              <a 
                href="{% if block.settings[link_key] != blank %}{{ block.settings[link_key] }}{% else %}{{ block.settings.default_quote_link }}{% endif %}" 
                class="ai-tradeshow-quote-btn-{{ ai_gen_id }}"
