    {
      "type": "text",
      "id": "cell4_title",
      "label": "Title",
      "default": "CUSTOM FABRICATION"
    },
    {
      "type": "url",
      "id": "cell4_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "cta_title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
