    },
    {
      "type": "text",
      "id": "stat2_number",
      "label": "Stat 2 number",
      "default": "48H"
    },
    {
      "type": "text",
      "id": "stat2_label",
      "label": "Stat 2 label",
      "default": "PRODUCTION"
    },
    {
      "type": "color",
      "id": "stat_number_color",
      "label": "Stat number color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Cell 1 button"
    },
    {
      "type": "text",
      "id": "cell1_button_text",
