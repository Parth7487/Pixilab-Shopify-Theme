      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Cell 2 - Hero image"
    },
    {
      "type": "image_picker",
      "id": "cell2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "cell2_badge_text",
      "label": "Badge text",
      "default": "ENTERPRISE CONFIG"
    },
    {
      "type": "color",
      "id": "badge_dot_color",
      "label": "Badge dot color",
      "default": "#00B9F1"
    },
    {
      "type": "header",
      "content": "Cell 3 - Product feature"
    },
    {
      "type": "text",
      "id": "cell3_tag",
      "label": "Product tag",
      "default": "10x10 KIT"
    },
    {
      "type": "image_picker",
      "id": "cell3_bg_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "cell3_title",
      "label": "Product title",
      "default": "POP-UP DISPLAY"
    },
    {
      "type": "color",
      "id": "product_bg_color",
      "label": "Background",
      "default": "#F4F4F5"
    },
    {
      "type": "header",
      "content": "Cell 4 - CTA card"
