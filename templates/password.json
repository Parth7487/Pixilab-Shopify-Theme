        "custom_liquid_4hnA7N": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<!-- 🚀 The \"Double-Tap\" Cart Hack Plugin for Shopify -->\n<!-- Paste this block directly into your Shopify Product Custom Liquid block! -->\n\n<!-- 🍱 Simple Pricing Styles -->\n<style>\n  #sinalite-live-price-card {\n    margin: 20px 0;\n    display: none; \/* Hidden until price loads *\/\n  }\n  .price-amount {\n    font-size: 32px;\n    font-weight: 700;\n    color: #333; \/* Dark Gray like your screenshot *\/\n  }\n<\/style>\n\n<div id=\"sinalite-advanced-builder\">\n\n\n<div id=\"sinalite-live-price-card\">\n  <div class=\"price-amount\">\n    $<span id=\"calculated-price-amount\">0.00<\/span>\n  <\/div>\n<\/div>\n\n<!-- We don't use a custom button anymore! We let OPTIS and Shopify use their native Add to Cart button so file uploads work flawlessly! -->\n\n<script>\n  \/\/ 1. Render.com Server\n  const MIDDLEWARE_SERVER_URL = \"https:\/\/shopify-sinalite-app.onrender.com\";\n\n  \/\/ 2. Dynamically grab the IDs!\n  let baseProductId = null;\n  let pricingUnitId = null;\n\n  {% for variant in product.variants %}\n  {% if variant.title contains \"Base\" %}\n  baseProductId = \"{{ variant.id }}\";\n  {% elsif variant.title contains \"Pricing\" %}\n  pricingUnitId = \"{{ variant.id }}\";\n  {% else %}\n  {% if forloop.first %}\n  baseProductId = \"{{ variant.id }}\";\n  {% endif %}\n  {% endif %}\n  {% endfor %}\n\n  \/\/ Fallback if variants aren't named perfectly yet\n  if (!pricingUnitId) pricingUnitId = baseProductId;\n  window.globalRetailPrice = 0.00;\n  window.lastSinaliteBasePrice = 0.00; \/\/ Force these to be global\n  const SINALITE_PRODUCT_ID = \"{{ product.variants.first.sku }}\".trim();\n\n  \/\/ --- Optis Addon Logic (Final Multi-Layered Version) ---\n  const getOptisAddonPrice = () => {\n    let extra = 0;\n\n    \/\/ 🟢 Layer 1: Check standard Checked Radios (using the IDs we found)\n    const emailYesInput = document.querySelector('input[name=\"po_radio_button1158196\"][value=\"YES\"]:checked');\n    if (emailYesInput) extra += 5.00;\n\n    const designYesInput = document.querySelector('input[name=\"po_radio_button1158217\"][value=\"YES\"]:checked');\n    if (designYesInput) extra += 59.99;\n    \/\/ Search everything on the page for \"email proof\" or \"Design Services\"\n    document.querySelectorAll('fieldset, .product-option, div[data-option-name]').forEach(section => {\n      var sectionText = section.innerText.toLowerCase();\n\n      \/\/ Look for a selected \"YES\" within this section\n      var hasYes = Array.from(section.querySelectorAll('input:checked, .active, .selected, label')).find(el => {\n        var val = (el.value || el.innerText || \"\").toUpperCase();\n        \/\/ If it's a radio button it must be checked. If it's a label it must look active.\n        if (el.tagName === 'INPUT') return val.includes(\"YES\") && el.checked;\n        if (el.tagName === 'LABEL' || el.tagName === 'DIV') return val.includes(\"YES\") && (el.classList.contains('active') || el.classList.contains('selected') || window.getComputedStyle(el).backgroundColor !== 'rgba(0, 0, 0, 0)');\n        return false;\n      });\n\n      if (hasYes) {\n        if (sectionText.includes('email proof')) extra += 5.00;\n        if (sectionText.includes('design services')) extra += 59.99;\n      }\n    });\n\n    return extra;\n  };\n\n  function refreshPriceDisplay() {\n    var addonTotal = getOptisAddonPrice();\n    window.globalRetailPrice = window.lastSinaliteBasePrice + addonTotal;\n\n    var amountEl = document.getElementById(\"calculated-price-amount\");\n    var containerEl = document.getElementById(\"sinalite-live-price-card\");\n\n    if (amountEl && window.lastSinaliteBasePrice > 0) {\n      amountEl.innerText = window.globalRetailPrice.toFixed(2);\n      if (containerEl) containerEl.style.display = \"block\";\n    }\n  }\n\n  \/\/ Check every second automatically\n  setInterval(refreshPriceDisplay, 1000);\n\n  if (SINALITE_PRODUCT_ID) {\n    fetch(`${MIDDLEWARE_SERVER_URL}\/api\/product\/${SINALITE_PRODUCT_ID}`)\n      .then(res => res.json())\n      .then(productData => {\n        const builderBox = document.getElementById(\"sinalite-advanced-builder\");\n        builderBox.innerHTML = \"\";\n\n        const flatOptions = productData[0];\n        const optionsGrouped = {};\n        flatOptions.forEach(opt => {\n          if (!optionsGrouped[opt.group]) optionsGrouped[opt.group] = [];\n          optionsGrouped[opt.group].push({ id: opt.id, name: opt.name });\n        });\n\n        const orderMap = [\n          { key: 'STOCK', label: 'Card Stock (Material)' },\n          { key: 'SIZE', label: 'Size' },\n          { key: 'QTY', label: 'Quantity' },\n          { key: 'QUANTITY', label: 'Quantity' },\n          { key: 'COATING', label: 'Coating (Lamination\/Finish)' },\n          { key: 'ROUND CORNERS', label: 'Round Corners' },\n          { key: 'SPOT UV', label: 'Spot UV' },\n          { key: 'BINDERY', label: 'Bindery options' },\n          { key: 'TURNAROUND', label: 'Turnaround Period (Production time)' }\n        ];\n\n        const groupOrder = Object.keys(optionsGrouped).sort((a, b) => {\n          const findPos = (name) => {\n            const idx = orderMap.findIndex(m => name.toUpperCase().includes(m.key));\n            return idx === -1 ? 99 : idx;\n          };\n          return findPos(a) - findPos(b);\n        });\n\n        for (const groupName of groupOrder) {\n          const values = optionsGrouped[groupName];\n          const mapMatch = orderMap.find(m => groupName.toUpperCase().includes(m.key));\n          const cleanLabel = mapMatch ? mapMatch.label : groupName.toUpperCase();\n\n          let html = `<label style=\"display:block; margin-top: 15px; margin-bottom: 5px; font-size: 14px; color: #333;\"><b>${cleanLabel}<\/b><\/label>`;\n          html += `<select class=\"sinalite-dropdown\" style=\"margin-bottom: 20px; padding: 12px; width: 100%; border: 1px solid #ddd; border-radius: 4px; background: #fff; font-size: 16px; color: #333;\">`;\n\n          values.forEach(val => {\n            html += `<option value=\"${val.id}\">${val.name}<\/option>`;\n          });\n\n          html += `<\/select>`;\n          builderBox.innerHTML += html;\n        }\n\n        document.querySelectorAll('.sinalite-dropdown').forEach(dropdown => {\n          dropdown.addEventListener('change', fetchLivePrice);\n        });\n\n        fetchLivePrice();\n      })\n      .catch(err => {\n        console.error(\"Sinalite API error:\", err);\n      });\n  }\n\n  function fetchLivePrice() {\n    const selectedIds = [];\n    document.querySelectorAll('.sinalite-dropdown').forEach(dropdown => {\n      selectedIds.push(parseInt(dropdown.value));\n    });\n\n    const payload = { productOptions: selectedIds };\n\n    fetch(`${MIDDLEWARE_SERVER_URL}\/api\/price\/${SINALITE_PRODUCT_ID}`, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application\/json\" },\n      body: JSON.stringify(payload)\n    })\n      .then(res => res.json())\n      .then(priceData => {\n        if (priceData.retailPrice) {\n          window.lastSinaliteBasePrice = parseFloat(priceData.retailPrice);\n          refreshPriceDisplay();\n        }\n      });\n  }\n\n  \/\/ Monitor Optis buttons instantly\n  document.addEventListener('change', (e) => {\n    if (e.target.name && e.target.name.includes(\"po_radio_button\")) {\n      refreshPriceDisplay();\n    }\n  });\n\n  \/\/ ─── THE MAGIC DOUBLE-TAP ───\n  \/\/ We use intercept logic. When OPTIS or the native Shopify Cart finishes adding the Base Product...\n  \/\/ We instantly add the mathematically correct number of '$0.01' pricing units into the cart and jump to checkout!\n\n  const originalFetch = window.fetch;\n  window.fetch = async function (...args) {\n    const url = args[0] || \"\";\n\n    \/\/ Call the original fetch (which allows OPTIS to upload the file to Shopify Cart successfully)\n    const response = await originalFetch.apply(this, args);\n\n    \/\/ If Shopify just successfully added the main item to the cart...\n    if (typeof url === 'string' && url.includes(\"\/cart\/add\") && response.ok) {\n\n      \/\/ Let's hijack the process momentarily to add the exact price!\n      \/\/ Convert $33.05 into 3305 distinct one-cent pricing units\n      let totalCents = parseInt(Math.round(window.globalRetailPrice * 100));\n\n      \/\/ Get the descriptive labels to put inside the cart so you know what to print\n      const customProperties = {};\n      document.querySelectorAll('.sinalite-dropdown').forEach(dropdown => {\n        const selectedText = dropdown.options[dropdown.selectedIndex].text;\n        const groupName = dropdown.previousElementSibling.innerText;\n        customProperties[groupName] = selectedText;\n      });\n\n      const pricingPayload = {\n        items: [\n          {\n            id: pricingUnitId, \/\/ This targets your $0.01 variant automatically!\n            quantity: totalCents,\n            properties: customProperties\n          }\n        ]\n      };\n\n      \/\/ Inject the units quietly into the cart\n      originalFetch(\"\/cart\/add.js\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application\/json\" },\n        body: JSON.stringify(pricingPayload)\n      }).then(() => {\n        \/\/ Once the pricing units are successfully inserted, redirect to cart!\n        window.location.href = \"\/checkout\";\n      });\n    }\n\n    return response;\n  };\n\n  \/\/ Set Shopify's native hidden Add To Cart ID to the Base Product ($0.00)\n  \/\/ This ensures the native button (and OPTIS) only charges $0.00 for the uploaded file item.\n  setInterval(() => {\n    const nativeVariantInputs = document.querySelectorAll('input[name=\"id\"]');\n    nativeVariantInputs.forEach(input => {\n      if (baseProductId && baseProductId !== \"\") {\n        input.value = baseProductId;\n      }\n    });\n  }, 1000);\n\n<\/script>"
          }
        },
