        "custom_liquid_PDWzye": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<!-- 🚀 Sinalite Dropdowns + Pricing Logic -->\n<div id=\"sinalite-advanced-builder\">\n  <h4 style=\"color: #333;\">Loading Live Print Options...<\/h4>\n<\/div>\n\n<script>\n  const MIDDLEWARE_SERVER_URL = \"https:\/\/shopify-sinalite-app.onrender.com\";\n  let baseProductId = null, pricingUnitId = null;\n\n  {% for variant in product.variants %}\n    {% if variant.title contains \"Base\" %} baseProductId = \"{{ variant.id }}\";\n    {% elsif variant.title contains \"Pricing\" %} pricingUnitId = \"{{ variant.id }}\";\n    {% else %}{% if forloop.first %} baseProductId = \"{{ variant.id }}\"; {% endif %}\n    {% endif %}\n  {% endfor %}\n  if (!pricingUnitId) pricingUnitId = baseProductId;\n\n  let globalRetailPrice = 0.00;\n  const SINALITE_PRODUCT_ID = \"{{ product.variants.first.sku }}\".trim();\n\n  if (SINALITE_PRODUCT_ID) {\n    fetch(`${MIDDLEWARE_SERVER_URL}\/api\/product\/${SINALITE_PRODUCT_ID}`)\n      .then(res => res.json())\n      .then(productData => {\n        const builderBox = document.getElementById(\"sinalite-advanced-builder\");\n        builderBox.innerHTML = \"\"; \n        const flatOptions = productData[0]; \n        const optionsGrouped = {};\n        flatOptions.forEach(opt => {\n           if (!optionsGrouped[opt.group]) optionsGrouped[opt.group] = [];\n           optionsGrouped[opt.group].push({ id: opt.id, name: opt.name });\n        });\n        const ORDER_MAP = [\"Card Stock\", \"Stock\", \"Size\", \"Quantity\", \"QTY\", \"Coating\", \"Round Corners\", \"Spot UV\", \"Turnaround Period\", \"Turnaround\"];\n        const sortedGroups = Object.keys(optionsGrouped).sort((a, b) => {\n          let indexA = ORDER_MAP.findIndex(item => a.toLowerCase().includes(item.toLowerCase()));\n          let indexB = ORDER_MAP.findIndex(item => b.toLowerCase().includes(item.toLowerCase()));\n          if (indexA === -1) indexA = 999;\n          if (indexB === -1) indexB = 999;\n          return indexA - indexB;\n        });\n        sortedGroups.forEach(groupName => {\n          const values = optionsGrouped[groupName];\n          values.sort((a, b) => {\n            const numA = parseFloat(a.name.replace(\/[^0-9.]\/g, '')) || 0;\n            const numB = parseFloat(b.name.replace(\/[^0-9.]\/g, '')) || 0;\n            return numA - numB;\n          });\n          let html = `<label style=\"display:block; margin-top: 10px;\"><b>${groupName.toUpperCase()}<\/b><\/label>`;\n          html += `<select class=\"sinalite-dropdown\" style=\"margin-bottom: 15px; padding: 10px; width: 100%; border: 1px solid #ccc; border-radius: 5px;\">`;\n          values.forEach(val => { html += `<option value=\"${val.id}\">${val.name}<\/option>`; });\n          html += `<\/select>`;\n          builderBox.innerHTML += html;\n        });\n        document.querySelectorAll('.sinalite-dropdown').forEach(dropdown => { dropdown.addEventListener('change', fetchLivePrice); });\n        fetchLivePrice(); \n      });\n  }\n\n  function fetchLivePrice() {\n    const selectedIds = [];\n    document.querySelectorAll('.sinalite-dropdown').forEach(dropdown => { selectedIds.push(parseInt(dropdown.value)); });\n    fetch(`${MIDDLEWARE_SERVER_URL}\/api\/price\/${SINALITE_PRODUCT_ID}`, {\n      method: \"POST\", headers: { \"Content-Type\": \"application\/json\" }, body: JSON.stringify({ productOptions: selectedIds })\n    }).then(res => res.json()).then(priceData => {\n        if (priceData.retailPrice) {\n          globalRetailPrice = parseFloat(priceData.retailPrice);\n          const pEl = document.getElementById(\"sinalite-live-price\");\n          if (pEl) pEl.style.display = \"block\";\n          const pAmt = document.getElementById(\"calculated-price-amount\");\n          if (pAmt) pAmt.innerText = priceData.retailPrice;\n        }\n      });\n  }\n\n  \/\/ 💎 THE PRICING HACK (Double-Tap)\n  const originalFetch = window.fetch;\n  window.fetch = async function(...args) {\n    const url = args[0] || \"\";\n    const response = await originalFetch.apply(this, args);\n    if (typeof url === 'string' && url.includes(\"\/cart\/add\") && response.ok) {\n        let totalCents = parseInt(Math.round(globalRetailPrice * 100));\n        const customProperties = {};\n        document.querySelectorAll('.sinalite-dropdown').forEach(dropdown => {\n            const selectedText = dropdown.options[dropdown.selectedIndex].text;\n            const groupName = dropdown.previousElementSibling.innerText;\n            customProperties[groupName] = selectedText;\n        });\n\n        \/\/ Add the second part of the hack (The pricing units)\n        originalFetch(\"\/cart\/add.js\", {\n            method: \"POST\", headers: { \"Content-Type\": \"application\/json\" },\n            body: JSON.stringify({ items: [{ id: pricingUnitId, quantity: totalCents, properties: customProperties }] })\n        }).then(() => { window.location.href = \"\/checkout\"; });\n    }\n    return response;\n  };\n\n  \/\/ Force variant to Base product for the main ADD button\n  setInterval(() => {\n      document.querySelectorAll('input[name=\"id\"]').forEach(input => { \n          if (baseProductId && input.value !== pricingUnitId) input.value = baseProductId; \n      });\n  }, 1000);\n<\/script>"
